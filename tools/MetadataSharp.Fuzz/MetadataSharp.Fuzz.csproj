<Project Sdk="Microsoft.NET.Sdk">
  <!-- The SharpFuzz harness. It is not part of the solution and nothing ships it: SharpFuzz is a
       dependency of this tool only, never of MetadataSharp.Core or MetadataSharp.Formats. The fuzz
       targets themselves are in FuzzTargets.cs, which the test project compiles too, so that every
       minimized failure in tests/fixtures/fuzz is replayed by the ordinary test run. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Replay outside afl-fuzz hands the instrumented assemblies a private coverage map. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SharpFuzz" Version="2.2.0" />
    <ProjectReference Include="../../src/MetadataSharp.Formats/MetadataSharp.Formats.csproj" />
  </ItemGroup>
</Project>
