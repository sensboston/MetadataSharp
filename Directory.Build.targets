<Project>
  <!-- Audit-only local candidates. Normal builds remain non-packable. No publication target. -->

  <ItemGroup Condition="'$(MetadataSharpAuditPackage)' == 'true' and ('$(MSBuildProjectName)' == 'MetadataSharp.Core' or '$(MSBuildProjectName)' == 'MetadataSharp.Formats')">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
